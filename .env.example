# Copy to .env and fill in. Never commit .env.

# Claude API key. Without it the server runs in mock mode.
ANTHROPIC_API_KEY=

# Optional: model and reasoning effort for the scan call.
# Effort is one of low, medium, high, xhigh, max. Higher is slower and costs more.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Optional: raises the Google Books rate limit.
GOOGLE_BOOKS_API_KEY=

# Set to 1 to force fixtures even when a key is present.
MOCK=

# Port of the API server (the Vite dev server proxies /api to it).
PORT=8787
