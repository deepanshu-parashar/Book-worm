# Copy to .env and fill in. Never commit .env.

# Claude API key. Without it the server runs in mock mode.
ANTHROPIC_API_KEY=

# Optional: raises the Google Books rate limit.
GOOGLE_BOOKS_API_KEY=

# Set to 1 to force fixtures even when a key is present.
MOCK=

# Port of the API server (the Vite dev server proxies /api to it).
PORT=8787
